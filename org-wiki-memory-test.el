;;; org-wiki-memory-test.el --- Agent memory regression tests -*- lexical-binding: t; -*-

;;; Commentary:
;; Exercise project scoping and mutation semantics without the user corpus.

;;; Code:
(require 'ert)
(require 'org-wiki-memory)
(require 'org-wiki-qmd-test)

(defvar org-roam-directory)
(declare-function org-roam-db-sync "org-roam-db" (&optional force))
(declare-function org-roam-db--close "org-roam-db" (&optional db))

(defmacro org-wiki-memory-test--with-roam (&rest body)
  "Run BODY against an isolated Org-roam database with the wiki under it."
  (declare (indent 0))
  `(org-wiki-qmd-test--fixture
    (let ((org-roam-directory base)
          (org-roam-db-location (expand-file-name "roam.sqlite" base)))
      (require 'org-roam)
      (unwind-protect (progn ,@body)
        (org-roam-db--close)))))

(ert-deftest org-wiki-memory-automatic-roam-links ()
  (org-wiki-memory-test--with-roam
   (let* ((ctx '((project . "A") (host . "test") (session . "1") (request . "save")))
          (args '((title . "离线索引") (category . "decision") (summary . "离线索引使用嵌入引擎。")
                  (body . "用SQLite验证。共同名称。NoSQL。[[id:source-id][实验]] [[id:missing][唯一主题]]")))
          (nodes (expand-file-name "topics.org" base)))
     ;; Ordinary file/heading nodes outside the wiki and a source inside it.
     (with-temp-file nodes
       (insert ":PROPERTIES:\n:ID: sqlite-id\n:ROAM_ALIASES: \"嵌入引擎\" \"共同名称\"\n:END:\n#+title: SQLite\n"
               "* 唯一主题\n:PROPERTIES:\n:ID: topic-id\n:ROAM_ALIASES: \"共同名称\"\n:END:\n"
               "* SQL\n:PROPERTIES:\n:ID: sql-id\n:END:\n"))
     (with-temp-file (expand-file-name "reference.org" org-wiki-root)
       (insert ":PROPERTIES:\n:ID: source-id\n:WIKI_KIND: Source-Record\n:END:\n#+title: 来源记录\n"))
     (org-roam-db-sync)
     (let* ((row (org-wiki-memory--call "remember" ctx args))
            (id (plist-get row :id))
            (file (gethash id org-id-locations))
            (key (list (cons 'id id)))
            (edit (append key (list (cons 'expected_revision (plist-get row :revision))
                                    '(title . "修订") '(summary . "唯一主题")
                                    '(body . "引用已修订"))
                          args)))
       (should (equal (plist-get row :related_ids) ["source-id" "sqlite-id"]))
       (should (equal (plist-get row :body) (alist-get 'body args)))
       (should (equal row (org-wiki-memory--call "read" ctx key)))
       (should (equal row (org-wiki-memory--call "remember" ctx args)))
       (with-temp-buffer
         (insert-file-contents file)
         (should (search-forward "- [[id:sqlite-id][SQLite]]\n  : 离线索引使用嵌入引擎。" nil t)))
       (dolist (target '("source-id" "sqlite-id"))
         (should (equal (mapcar (lambda (edge) (plist-get edge :from-id))
                                (org-wiki--backlinks target))
                        (list id))))
       (should-not (seq-some (lambda (issue) (equal id (plist-get issue :id)))
                             (plist-get (org-wiki--health) :issues)))
       (let ((updated (org-wiki-memory--call "update" (cons '(request . "edit") ctx) edit)))
         (should (equal (plist-get updated :related_ids) ["topic-id"]))
         (should-not (org-wiki--backlinks "sqlite-id"))
         (should-not (org-wiki--backlinks "source-id"))
         (should (equal id (plist-get (car (org-wiki--backlinks "topic-id")) :from-id)))
         (org-wiki-memory--call "forget" ctx (cons (cons 'expected_revision (plist-get updated :revision)) key))
         (should-not (org-wiki--backlinks "topic-id")))))))

(ert-deftest org-wiki-memory-roam-links-verify-stale-nodes-and-retry-index ()
  (org-wiki-memory-test--with-roam
   (let ((legacy (expand-file-name "legacy.org" org-wiki-root))
         (stale (expand-file-name "stale.org" base))
         (ctx '((project . "A") (host . "test") (session . "1") (request . "once")))
         (args '((title . "核对") (summary . "使用旧别名和旧主题") (category . "fact")
                 (body . "[[id:old-file]] [[id:removed]]"))))
     (with-temp-file legacy
       (insert ":PROPERTIES:\n:ID: old-file\n:END:\n#+title: 算法\n"
               "* 算法\n:PROPERTIES:\n:ID: canonical\n:WIKI_KIND: Concept\n:END:\n"))
     (with-temp-file stale
       (insert "* 旧主题\n:PROPERTIES:\n:ID: renamed\n:ROAM_ALIASES: 旧别名\n:END:\n"
               "* 已删除的标题\n:PROPERTIES:\n:ID: removed\n:END:\n"))
     (org-roam-db-sync)
     (with-temp-file stale (insert "* 新主题\n:PROPERTIES:\n:ID: renamed\n:END:\n"))
     (let ((row (cl-letf (((symbol-function 'org-roam-db-update-file)
                           (lambda (&rest _) (error "Fixture index unavailable"))))
                  (org-wiki-memory--call "remember" ctx args))))
       (should (equal (plist-get row :related_ids) ["canonical"]))
       (should-not (org-wiki--backlinks "canonical"))
       (should (equal row (org-wiki-memory--call "remember" ctx args)))
       (should (equal (plist-get row :id)
                      (plist-get (car (org-wiki--backlinks "canonical")) :from-id)))))))

(ert-deftest org-wiki-memory-roam-link-scope-and-fallback ()
  (org-wiki-memory-test--with-roam
   (let* ((ctx '((project . "A") (host . "test") (session . "1")))
          (args '((title . "本项目决定") (summary . "说明") (body . "记录") (category . "fact"))))
     (org-roam-db-sync)
     (let* ((local (org-wiki-memory--call "remember" (cons '(request . "local") ctx) args))
            (personal (org-wiki-memory--call "remember" (cons '(request . "pref") ctx)
                                             (append '((scope . "personal") (title . "跨项目偏好")) args)))
            (foreign (org-wiki-memory--call "remember" (append '((project . "B") (request . "peer")) ctx)
                                            (cons '(title . "外部决定") args)))
            (body (format "跨项目偏好、本项目决定和外部决定。[[id:%s][私有]]" (plist-get foreign :id)))
            (fields (append (list '(title . "观察") (cons 'body body)) args))
            (row (org-wiki-memory--call "remember" (cons '(request . "new") ctx) fields))
            (id (plist-get row :id))
            (links (vector (plist-get personal :id) (plist-get local :id)))
            (edit (append (list (cons 'id id) (cons 'expected_revision (plist-get row :revision))
                                '(title . "仅引用自身")
                                (cons 'body (format "[[id:%s]]" id))) fields)))
       (should (equal (plist-get row :related_ids) links))
       (should (equal (plist-get (org-wiki-memory--call
                                  "remember" (cons '(request . "shared") ctx)
                                  (cons '(scope . "personal") fields)) :related_ids)
                      (vector (plist-get personal :id))))
       (let ((org-roam-db-location nil))
         (let ((offline (org-wiki-memory--call "update" (cons '(request . "offline") ctx) edit)))
           (should (equal (plist-get offline :related_ids) links))
           (setf (alist-get 'expected_revision edit) (plist-get offline :revision))))
       (let ((self (org-wiki-memory--call "update" (cons '(request . "online") ctx) edit)))
         (should (equal (plist-get self :related_ids) [])))
       (let ((org-wiki-memory-max-links 1))
         (should (equal (plist-get (org-wiki-memory--call
                                    "remember" (cons '(request . "cap") ctx)
                                    (cons (cons 'body (format "%s [[id:%s]]" body (plist-get local :id)))
                                          fields)) :related_ids)
                        (vector (plist-get local :id)))))
       (let ((org-wiki-memory-max-links 0))
         (should (equal (plist-get (org-wiki-memory--call "remember" (cons '(request . "off") ctx) fields)
                                   :related_ids)
                        [])))))))

(ert-deftest org-wiki-memory-lifecycle ()
  (let* ((org-wiki-root (make-temp-file "memory-test" t))
         (org-id-locations (make-hash-table :test #'equal))
         (org-id-locations-file (expand-file-name ".ids" org-wiki-root))
         (ctx '((project . "A") (host . "pi") (session . "1") (request . "a")))
         (other (cons '(project . "B") ctx))
         (args '((category . "decision") (title . "项目验收")
                 (summary . "使用 make check 验收") (body . "Run make check."))))
    (unwind-protect
        (let* ((row (org-wiki-memory--call "remember" ctx args))
               (id (plist-get row :id))
               (key (list (cons 'id id)))
               (query '((query . "项目如何验收？")))
               (change (append key (list (cons 'expected_revision (plist-get row :revision)))
                               (cons '(summary . "使用新的测试") args))))
          (should (equal row (org-wiki-memory--call "remember" ctx args)))
          (should (equal row (org-wiki-memory--call "read" ctx key)))
          (should (= 1 (length (org-wiki-memory--call "search" ctx query))))
          (should (= 0 (length (org-wiki-memory--call "search" other query))))
          (should-error (org-wiki-memory--call "read" other key) :type 'org-wiki-error)
          (let* ((updated (org-wiki-memory--call "update" ctx change))
                 (forget (append key (list (cons 'expected_revision (plist-get updated :revision))))))
            (should (equal "使用新的测试" (plist-get updated :summary)))
            (should-error (org-wiki-memory--call "update" ctx (cons '(body . "stale") change))
                          :type 'org-wiki-error)
            (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
            (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
            (should-error (org-wiki-memory--call "read" ctx key) :type 'org-wiki-error))
          (org-wiki-memory--call "remember" (cons '(request . "b") ctx)
                                 (cons '(scope . "personal") args))
          (should (= 1 (length (org-wiki-memory--call "search" other query)))))
      (delete-directory org-wiki-root t))))

(ert-deftest org-wiki-memory-timestamped-filenames ()
  (let* ((org-wiki-root (make-temp-file "memory-filenames" t))
         (org-id-locations (make-hash-table :test #'equal))
         (org-id-method 'uuid)
         (org-id-prefix nil)
         (ctx '((project . "A") (host . "pi") (session . "alice") (request . "save")))
         (other (cons '(session . "bob") ctx))
         (args '((category . "fact") (title . "Test") (summary . "Test") (body . "Same content")))
         (now (encode-time 0 30 8 22 11 2026 t)))
    (unwind-protect
        (cl-letf (((symbol-function 'current-time) (lambda () now)))
          (let* ((row (org-wiki-memory--call "remember" ctx args))
                 (id (plist-get row :id))
                 (key (list (cons 'id id)))
                 (file (gethash id org-id-locations))
                 (dir (file-name-directory file))
                 (legacy-row (org-wiki-memory--call "remember" other args))
                 (legacy-id (plist-get legacy-row :id))
                 (other-file (gethash legacy-id org-id-locations))
                 (legacy-file (expand-file-name (concat legacy-id ".org") dir)))
            (dolist (entry (list (cons id file) (cons legacy-id other-file)))
              (should (org-uuidgen-p (car entry)))
              (should (string-match-p
                       (concat "\\`20261122T083000Z-[a-f0-9]\\{12\\}-" (regexp-quote (car entry)) "\\.org\\'")
                       (file-name-nondirectory (cdr entry)))))
            (should-not (equal (substring (file-name-nondirectory file) 17 29)
                               (substring (file-name-nondirectory other-file) 17 29)))
            (clrhash org-id-locations)
            (setq now (time-add now 60))
            (should (equal row (org-wiki-memory--call "remember" ctx args)))
            (should (equal row (org-wiki-memory--call "read" ctx key)))
            (should-error (org-wiki-memory--call "remember" ctx (cons '(body . "Changed") args))
                          :type 'org-wiki-error)
            (should (= 2 (length (directory-files dir nil "\\.org\\'"))))
            (rename-file other-file legacy-file)
            (let* ((legacy-key (list (cons 'id legacy-id)))
                   (change (append legacy-key
                                   (list (cons 'expected_revision (plist-get legacy-row :revision))
                                         '(body . "Changed"))
                                   args)))
              (should (equal legacy-row (org-wiki-memory--call "remember" other args)))
              (should (equal legacy-row (org-wiki-memory--call "read" other legacy-key)))
              (should (equal "Changed" (plist-get (org-wiki-memory--call "update" other change) :body)))
              (should (file-equal-p legacy-file (gethash legacy-id org-id-locations))))))
      (delete-directory org-wiki-root t))))

(ert-deftest org-wiki-memory-native-file-id-and-retries ()
  (org-wiki-qmd-test--fixture
   (let* ((org-id-method 'ts) (org-id-ts-format "2026-11-25") (org-id-include-domain nil)
          (ctx '((project . "A") (host . "pi") (session . "s") (request . "save")))
          (args '((category . "fact") (title . "Note") (summary . "Test") (body . "Original")))
          (dir (org-wiki-memory--directory (secure-hash 'sha256 "A"))))
     (dolist (prefix (list "../nested" (make-string 510 ?x)))
       (let* ((org-id-prefix prefix)
              (ctx (cons (cons 'request (secure-hash 'sha256 prefix)) ctx))
              (id (concat prefix ":" org-id-ts-format))
              (args-id (list (cons 'id id)))
              (row (org-wiki-memory--call "remember" ctx args))
              (file (gethash id org-id-locations)))
         (should (equal id (plist-get row :id)))
         (should (file-equal-p dir (file-name-directory file)))
         (should (string-suffix-p (concat "-!" (secure-hash 'sha256 id) ".org") file))
         (with-temp-buffer
           (insert-file-contents file)
           (delay-mode-hooks (org-mode))
           (should (equal id (org-entry-get (point-min) "ID")))
           (re-search-forward "^\\* Summary$")
           (should-not (org-entry-get nil "ID")))
         (clrhash org-id-locations)
         (cl-letf (((symbol-function 'org-id-get-create) (lambda (&rest _) (ert-fail "Allocated another ID"))))
           (should (equal row (org-wiki-memory--call "remember" ctx args)))
           (should (equal row (org-wiki-memory--call "read" ctx args-id)))
           (should (equal (should-error (org-wiki-memory--call "remember" ctx (cons '(body . "Other") args)))
                          '(org-wiki-error :request_conflict)))
           (let* ((edit (append args-id (list (cons 'expected_revision (plist-get row :revision))
                                              '(body . "Updated")) args))
                  (updated (org-wiki-memory--call "update" ctx edit))
                  (forget (append args-id (list (cons 'expected_revision (plist-get updated :revision))))))
             (should (equal id (plist-get updated :id)))
             (should (equal updated (org-wiki-memory--call "update" ctx edit)))
             (should (file-equal-p file (car (org-id-find-id-in-file id (org-id-find-id-file id)))))
             (should (equal (should-error (org-wiki-memory--call "remember" ctx args))
                            '(org-wiki-error :request_conflict)))
             (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
             (clrhash org-id-locations)
             (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
             (should (equal (should-error (org-wiki-memory--call "remember" ctx args))
                            '(org-wiki-error :unknown_id)))
             (should (equal (should-error (org-wiki-memory--call "read" ctx args-id))
                            '(org-wiki-error :unknown_id)))))))
     (should (= 2 (length (directory-files dir nil "\\.org\\'")))))))

(ert-deftest org-wiki-memory-native-id-collisions-and-failed-write ()
  (org-wiki-memory-test--with-roam
   (let* ((org-id-method 'ts) (org-id-prefix nil) (org-id-include-domain nil)
          (org-id-ts-format "child")
          (ctx '((project . "A") (host . "pi") (session . "s") (request . "create")))
          (args '((category . "fact") (title . "One") (summary . "One") (body . "One"))))
     ;; "child" belongs to a regular Org heading in this fixture's Roam index.
     (org-roam-db-sync)
     (clrhash org-id-locations)
     (should (equal (should-error (org-wiki-memory--call "remember" ctx args))
                    '(org-wiki-error :id_conflict)))
     (setq org-id-ts-format "fixed")
     (cl-letf (((symbol-function 'org-wiki-memory--write) (lambda (&rest _) (signal 'file-error '("fixture")))))
       (should-error (org-wiki-memory--call "remember" ctx args) :type 'file-error))
     (should-not (gethash "fixed" org-id-locations))
     (let* ((row (org-wiki-memory--call "remember" ctx args))
            (other (cons '(project . "B") ctx))
            (args-id '((id . "fixed")))
            (org-roam-db-location nil))
       (clrhash org-id-locations)
       (should (equal row (org-wiki-memory--call "read" ctx args-id)))
       (should (equal (should-error (org-wiki-memory--call "read" other args-id)) '(org-wiki-error :unknown_id)))
       (should (equal (should-error (org-wiki-memory--call "remember" other args)) '(org-wiki-error :id_conflict)))
       (should (equal (should-error (org-wiki-memory--call "remember" ctx (cons '(scope . "personal") args)))
                      '(org-wiki-error :id_conflict)))
       (should (equal row (org-wiki-memory--call "read" ctx args-id)))
       (org-wiki-memory--call "forget" ctx (cons (cons 'expected_revision (plist-get row :revision)) args-id))
       (should (equal (should-error (org-wiki-memory--call "remember" other args)) '(org-wiki-error :id_conflict)))))))

(ert-deftest org-wiki-memory-in-flight-creation-retry ()
  (org-wiki-qmd-test--fixture
   (let* ((ctx '((project . "A") (host . "pi") (session . "s") (request . "same")))
          (args '((category . "fact") (title . "One") (summary . "One") (body . "One")))
          (native (symbol-function 'org-id-get-create))
          (allocations 0))
     (cl-letf (((symbol-function 'org-id-get-create)
                (lambda ()
                  (cl-incf allocations)
                  (when (= allocations 1)
                    (should (equal (should-error (org-wiki-memory--call "remember" ctx args))
                                   '(org-wiki-error :busy))))
                  (funcall native))))
       (let ((row (org-wiki-memory--call "remember" ctx args)))
         (should (equal row (org-wiki-memory--call "remember" ctx args)))
         (should (= 1 allocations))
         (should (= 1 (length (directory-files-recursively
                               (org-wiki-memory--directory (secure-hash 'sha256 "A")) "\\.org\\'")))))))))

(ert-deftest org-wiki-memory-legacy-file-ids-and-tombstones ()
  (org-wiki-memory-test--with-roam
   (let* ((project (secure-hash 'sha256 "A"))
          (dir (org-wiki-memory--directory project))
          (ctx '((project . "A") (host . "pi") (session . "s")))
          (args '((category . "fact") (title . "Old") (summary . "Summary") (body . "Original"))))
     (make-directory dir t)
     (org-roam-db-sync)
     (dolist (key '("bare" "timestamped"))
       (let* ((ctx (cons (cons 'request key) ctx))
              (id (concat "mem-" (secure-hash 'sha256 (prin1-to-string (list project "project" "pi/s" key)))))
              (request (secure-hash 'sha256 (prin1-to-string (list "remember" "pi/s" key args))))
              (file (expand-file-name (concat (unless (equal key "bare") "20261122T083000Z-abcdef123456-")
                                              id ".org") dir))
              (args-id (list (cons 'id id))))
         (with-temp-file file
           (insert ":PROPERTIES:\n:ID: " id "\n:WIKI_KIND: Memory\n:MEMORY_SCOPE: project\n:CATEGORY: fact"
                   "\n:MEMORY_SOURCE: pi/s\n:LAST_REQUEST: " request "\n:END:\n#+title: Old\n"
                   "\n* Summary\n: Summary\n\n* Body\n: Original\n"))
         (cl-letf (((symbol-function 'org-id-get-create) (lambda (&rest _) (ert-fail "Replaced a legacy ID"))))
           (let* ((row (org-wiki-memory--call "read" ctx args-id))
                  (edit (append args-id (list (cons 'expected_revision (plist-get row :revision))
                                              '(body . "Revised")) args)))
             (should (equal row (org-wiki-memory--call "remember" ctx args)))
             (let* ((updated (org-wiki-memory--call "update" ctx edit))
                    (forget (append args-id (list (cons 'expected_revision (plist-get updated :revision))))))
               (should (equal id (plist-get updated :id)))
               (should (equal file (car (org-id-find id))))
               (should (equal "Revised" (plist-get (org-wiki-memory--call "read" ctx args-id) :body)))
               (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
               ;; Also exercise tombstones left by pre-native-ID versions.
               (with-temp-file file
                 (insert "Forgotten " (secure-hash 'sha256 (prin1-to-string (list "forget" "pi/s" key forget))) "\n"))
               (should (plist-get (org-wiki-memory--call "forget" ctx forget) :forgotten))
               (should (equal (should-error (org-wiki-memory--call "remember" ctx args))
                              '(org-wiki-error :unknown_id)))))))))))

(ert-deftest org-wiki-memory-guards ()
  (let* ((org-wiki-root (make-temp-file "memory-guard" t))
         (ctx '((project . "A") (session . "1") (host . "pi") (request . "save")))
         (org-id-locations (make-hash-table :test #'equal))
         (args '((title . "Test") (summary . "test") (body . "original") (category . "fact")))
         (record (org-wiki-memory--call "remember" ctx args))
         (id (plist-get record :id))
         (file (gethash id org-id-locations))
         (buffer (find-file-noselect file))
         (edit (append (list (cons 'id id) (cons 'expected_revision (plist-get record :revision))) args)))
    (unwind-protect
        (progn
          (with-current-buffer buffer (goto-char (point-max)) (insert "Human edit"))
          (should-error (org-wiki-memory--call "update" ctx edit) :type 'org-wiki-error)
          (with-current-buffer buffer (save-buffer))
          (should-error (org-wiki-memory--call "update" ctx edit) :type 'org-wiki-error)
          (should-error (org-wiki-memory--call "read" ctx '((id . "../other.org"))) :type 'org-wiki-error)
          (make-symbolic-link file (expand-file-name "link.org" (file-name-directory file)))
          (should-error (org-wiki-memory--call "search" ctx '((query . "test"))) :type 'org-wiki-error)
          (should-error (org-wiki-memory--call "remember" ctx (cons '(scope . "all") args))
                        :type 'org-wiki-error))
      (kill-buffer buffer)
      (delete-directory org-wiki-root t))))

(ert-deftest org-wiki-memory-qmd-search-is-scoped ()
  (org-wiki-qmd-test--fixture
   (let* ((ctx '((project . "A") (host . "pi") (session . "1") (request . "save")))
          (other (cons '(project . "B") ctx))
          (args '((title . "Memory") (summary . "Literal keyword")
                  (body . "Remember this") (category . "fact")))
          (local (org-wiki-memory--call "remember" ctx args))
          (foreign (org-wiki-memory--call "remember" other args))
          (personal (org-wiki-memory--call "remember" ctx (cons '(scope . "personal") args)))
          (rank (list "parent" (plist-get foreign :id) (plist-get personal :id)
                      (plist-get local :id)))
          (org-wiki-qmd-test--output
           (json-serialize
            (vconcat (mapcar (lambda (id)
                               (list :file (format "qmd://wiki/%s.md?index=wiki-test"
                                                   (secure-hash 'sha256 id))))
                             rank))))
          (search '((query . "unmatched") (limit . 2)))
          (literal '((query . "Literal") (limit . 2))))
     (cl-letf (((symbol-function 'org-wiki-qmd--run) #'org-wiki-qmd-test--run))
       (org-wiki-qmd-setup)
       (org-wiki-qmd-sync)
       (let ((results (org-wiki-memory--call "search" ctx search)))
         (should (equal results (vector (org-wiki-memory--search-result personal)
                                        (org-wiki-memory--search-result local)))))
       (should (equal (org-wiki-memory--call "search" other search)
                      (vector (org-wiki-memory--search-result foreign)
                              (org-wiki-memory--search-result personal))))
       (org-wiki-memory--call "forget" (cons '(request . "forget") ctx)
                              (list (cons 'id (plist-get personal :id))
                                    (cons 'expected_revision (plist-get personal :revision))))
       (should (equal (org-wiki-memory--call "search" ctx search)
                      (vector (org-wiki-memory--search-result local))))
       (let ((org-wiki-qmd-test--fail "search"))
         (should (equal (org-wiki-memory--call "search" ctx literal)
                        (vector (org-wiki-memory--search-result local))))
         (should (equal org-wiki-qmd-last-error "Simulated CLI failure")))
       (let ((org-wiki-qmd-enabled nil)
             (org-wiki-qmd-test--calls nil))
         (should (equal (org-wiki-memory--call "search" ctx literal)
                        (vector (org-wiki-memory--search-result local))))
         (should-not org-wiki-qmd-test--calls))))))

(ert-deftest org-wiki-memory-indexes-verification-script ()
  (org-wiki-qmd-test--fixture
   (let* ((ctx `((project . ,base) (workspace . ,base) (host . "pi") (session . "s") (request . "r")))
          (args '((category . "fact") (kind . "术") (script_path . "verify.sh")
                  (title . "Verification") (summary . "Check isolation") (body . "Run sh verify.sh")))
          (script (expand-file-name "verify.sh" base)))
     (with-temp-file script (insert "echo scriptmarker\n"))
     (make-symbolic-link source (expand-file-name "link.sh" base))
     (dolist (bad '((script_path . "link.sh") (script_path . "../outside") (kind . "unknown")
                    (scope . "personal")))
       (should-error (org-wiki-memory--call "remember" ctx (cons bad args)) :type 'org-wiki-error))
     (let* ((row (org-wiki-memory--call "remember" ctx args))
            (id (plist-get row :id))
            (search '((query . "indexed query") (kind . "术"))))
       (cl-letf (((symbol-function 'org-wiki-qmd--run) #'org-wiki-qmd-test--run))
         (org-wiki-qmd-setup)
         (org-wiki-qmd-sync)
         (with-temp-buffer
           (insert-file-contents (org-wiki-qmd--path (concat "nodes/" (secure-hash 'sha256 id) ".md")))
           (should (search-forward "scriptmarker" nil t)))
         (should (equal (vector (org-wiki-memory--search-result row))
                        (org-wiki-memory--call "search" ctx search)))
         (delete-file script)
         (should (equal [] (org-wiki-memory--call "search" ctx search)))
         (should-error (org-wiki-memory--call "read" ctx `((id . ,id) (include_script . t)))
                       :type 'org-wiki-error)
         (let ((updated (org-wiki-memory--call
                         "update" ctx (append `((id . ,id) (expected_revision . ,(plist-get row :revision))
                                                (kind . :null) (script_path . :null)) args))))
           (should (equal (plist-get updated :kind) "Memory"))
           (should-not (plist-get updated :script_path))))))))

(ert-deftest org-wiki-memory-search-by-situation ()
  (org-wiki-qmd-test--fixture
   (let ((ctx '((project . "A") (host . "pi") (session . "s")))
         (org-wiki-qmd-enabled nil))
     (dolist (kind '("道" "法" "术"))
       (org-wiki-memory--call "remember" (cons (cons 'request kind) ctx)
                              `((kind . ,kind) (category . "lesson") (title . "并发")
                                (summary . "并发写入") (body . "concurrency"))))
     (dolist (example '(("understand" "道") ("design" "法") ("implement" "术")))
       (let ((rows (org-wiki-memory--call "search" ctx
                                          `((query . "并发") (limit . 1) (situation . ,(car example))))))
         (should (equal (plist-get (aref rows 0) :kind) (cadr example)))))
     (dolist (example '(("并发写入如何实现" "术") ("为什么并发写入" "道") ("design concurrency" "法")))
       (should (equal (plist-get (aref (org-wiki-memory--call "search" ctx
                                                              `((query . ,(car example)))) 0) :kind)
                      (cadr example))))
     (should (= 3 (length (org-wiki-memory--call "search" ctx '((query . "并发"))))))
     (let ((rows (org-wiki-memory--call "search" ctx '((query . "并发") (situation . "design") (kind . "术")))))
       (should (equal (plist-get (aref rows 0) :kind) "术")))
     (org-wiki-memory--call "remember" (cons '(request . "raw") ctx)
                            '((category . "fact") (title . "孤立观察") (summary . "孤立观察") (body . "raw")))
     (let ((rows (org-wiki-memory--call "search" ctx '((query . "孤立观察") (situation . "design")))))
       (should (equal (plist-get (aref rows 0) :kind) "Memory"))))))

